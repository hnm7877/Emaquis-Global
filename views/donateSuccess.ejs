<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>
		<link
			href="newAssets/css/bootstrap.css"
			rel="stylesheet"
		/>
		<link
			href="newAssets/css/main.css"
			rel="stylesheet"
		/>
		<link
			href="newAssets/css/responsive.css"
			rel="stylesheet"
		/>
		<title>Merci pour votre don — E-Maquis</title>
		<style>
			body {
				display: flex;
				justify-content: center;
				align-items: center;
				min-height: 100vh;
				margin: 0;
				background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
				font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
				overflow: hidden; /* Evite les barres de défilement liées aux confettis */
			}
			.success-container {
				position: relative;
				z-index: 10;
				padding: 20px;
				width: 100%;
				display: flex;
				justify-content: center;
			}
			.success-card {
				background: rgba(255, 255, 255, 0.95);
				backdrop-filter: blur(10px);
				border-radius: 24px;
				padding: 50px 40px;
				max-width: 500px;
				width: 100%;
				text-align: center;
				box-shadow: 0 20px 50px rgba(0,0,0,0.1), 0 0 0 1px rgba(255,255,255,0.5) inset;
				transform: translateY(20px);
				opacity: 0;
				animation: slideUpFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
			}
			.success-icon-wrapper {
				position: relative;
				width: 100px;
				height: 100px;
				margin: 0 auto 25px;
				background: linear-gradient(135deg, #22c55e, #16a34a);
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				box-shadow: 0 10px 25px rgba(34, 197, 94, 0.4);
				animation: scaleIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s forwards;
				transform: scale(0);
			}
			.success-icon {
				font-size: 3rem;
				color: white;
				animation: heartbeat 1.5s ease-in-out infinite 1s;
			}
			.success-card h2 {
				color: #1f2937;
				font-weight: 800;
				font-size: 2rem;
				margin-bottom: 15px;
				letter-spacing: -0.5px;
			}
			.success-card p {
				color: #4b5563;
				font-size: 1.1rem;
				line-height: 1.7;
				margin-bottom: 20px;
			}
			.highlight-text {
				background: linear-gradient(135deg, #22c55e, #16a34a);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				font-weight: bold;
			}
			.btn-back {
				background: linear-gradient(135deg, #22c55e, #16a34a);
				color: white;
				border: none;
				border-radius: 14px;
				padding: 14px 35px;
				font-weight: 700;
				font-size: 1.1rem;
				margin-top: 15px;
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 10px;
				transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
				box-shadow: 0 8px 20px rgba(34, 197, 94, 0.3);
				width: 100%;
			}
			.btn-back:hover {
				transform: translateY(-3px);
				box-shadow: 0 12px 25px rgba(34, 197, 94, 0.4);
				color: white;
				text-decoration: none;
			}
			.redirect-text {
				color: #9ca3af;
				font-size: 0.9rem;
				margin-top: 25px;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 8px;
			}
			.spinner {
				width: 16px;
				height: 16px;
				border: 2px solid #e5e7eb;
				border-top-color: #9ca3af;
				border-radius: 50%;
				animation: spin 1s linear infinite;
			}

			/* Animations */
			@keyframes slideUpFadeIn {
				to { transform: translateY(0); opacity: 1; }
			}
			@keyframes scaleIn {
				to { transform: scale(1); }
			}
			@keyframes heartbeat {
				0%, 100% { transform: scale(1); }
				15% { transform: scale(1.15); }
				30% { transform: scale(1); }
				45% { transform: scale(1.15); }
			}
			@keyframes spin {
				to { transform: rotate(360deg); }
			}

			/* Responsive tweaks */
			@media (max-width: 576px) {
				.success-card {
					padding: 40px 25px;
					border-radius: 20px;
				}
				.success-card h2 {
					font-size: 1.75rem;
				}
				.success-card p {
					font-size: 1rem;
				}
				.success-icon-wrapper {
					width: 80px;
					height: 80px;
				}
				.success-icon {
					font-size: 2.5rem;
				}
			}
		</style>
	</head>
	<body>
		<div class="success-container">
			<div class="success-card">
				<div class="success-icon-wrapper">
					<div class="success-icon">❤️</div>
				</div>
				<h2>Merci infiniment !</h2>
				<p>
					Votre don a été traité avec succès. Grâce à votre incroyable générosité, nous faisons un pas de plus vers notre objectif.
				</p>
				<p style="font-size: 0.95rem; background: #f3f4f6; padding: 15px; border-radius: 12px; margin-bottom: 25px;">
					<span class="highlight-text">Chaque geste compte</span> et fait une véritable différence pour E-Maquis.
				</p>
				<a href="/" class="btn-back">
					<span>Retourner à l'accueil</span>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</a>
				<div class="redirect-text">
					<div class="spinner"></div>
					<span>Redirection dans <strong id="countdown" style="color: #6b7280;">8</strong> secondes...</span>
				</div>
			</div>
		</div>

		<!-- Script Canvas Confetti -->
		<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
		<script>
			// Confetti Animation
			document.addEventListener("DOMContentLoaded", () => {
				// Burst initial explosif
				const count = 200;
				const defaults = {
					origin: { y: 0.7 },
					zIndex: 100
				};

				function fire(particleRatio, opts) {
					confetti(Object.assign({}, defaults, opts, {
						particleCount: Math.floor(count * particleRatio)
					}));
				}

				setTimeout(() => {
					fire(0.25, { spread: 26, startVelocity: 55 });
					fire(0.2, { spread: 60 });
					fire(0.35, { spread: 100, decay: 0.91, scalar: 0.8 });
					fire(0.1, { spread: 120, startVelocity: 25, decay: 0.92, scalar: 1.2 });
					fire(0.1, { spread: 120, startVelocity: 45 });
				}, 500);

				// Pluie de confettis continue
				const duration = 8 * 1000;
				const end = Date.now() + duration;

				(function frame() {
					confetti({
						particleCount: 3,
						angle: 60,
						spread: 55,
						origin: { x: 0, y: 0.1 },
						colors: ['#22c55e', '#16a34a', '#ff9966', '#ff5e62'],
						zIndex: 99
					});
					confetti({
						particleCount: 3,
						angle: 120,
						spread: 55,
						origin: { x: 1, y: 0.1 },
						colors: ['#22c55e', '#16a34a', '#ff9966', '#ff5e62'],
						zIndex: 99
					});

					if (Date.now() < end) {
						requestAnimationFrame(frame);
					}
				}());
			});

			// Countdown & Redirect
			let seconds = 8;
			const countdownEl = document.getElementById('countdown');
			const interval = setInterval(() => {
				seconds--;
				if (countdownEl) countdownEl.textContent = seconds;
				if (seconds <= 0) {
					clearInterval(interval);
					window.location.href = '/';
				}
			}, 1000);
		</script>
	</body>
</html>
