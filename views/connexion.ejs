<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>E-Maquis - Connexion & DepozUp Promo</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
    <script>
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#4F46E5",
              "primary-hover": "#4338ca",
              "background-light": "#f3f4f6",
              "background-dark": "#111827",
              "depozup-orange": "#f97316",
              "glass-dark": "rgba(255, 255, 255, 0.1)",
              "glass-border": "rgba(255, 255, 255, 0.2)",
              "success": "#06d6a0",
              "error": "#ef476f"
            },
            fontFamily: {
              display: ["Inter", "sans-serif"],
              body: ["Inter", "sans-serif"],
            },
            borderRadius: {
              DEFAULT: "0.5rem",
              'xl': "1rem",
              '2xl': "1.5rem",
            },
            backdropBlur: {
                'xs': '2px',
            }
          },
        },
      };
    </script>
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet"/>
    <!-- Lordicon -->
    <script src="https://cdn.lordicon.com/lordicon.js"></script>
    
    <style>
        body {
            font-family: "Inter", sans-serif
        }
        .bg-bar-scene {
            background-image: url('newAssets/images/background/bg-login.jpg');
            background-size: cover;
            background-position: center;
        }
        .glass-panel {
            background: rgba(30, 30, 30, 0.65);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37)
        }
        
        /* Animation classes for script compatibility */
        @keyframes slideIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
            20%, 40%, 60%, 80% { transform: translateX(5px); }
        }
        .shake {
            animation: shake 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
        }
        .animSuccessConnect, .animFailConnect {
            animation: slideIn 0.3s ease;
        }
    </style>
</head>
<body class="bg-bar-scene min-h-screen flex items-center justify-center p-4 md:p-8 text-white relative">
    <div class="absolute inset-0 bg-black/50 dark:bg-black/70 z-0"></div>
    <div class="absolute bottom-0 right-0 w-1/2 h-1/2 bg-purple-900/40 blur-[120px] rounded-full z-0 pointer-events-none"></div>
    <div class="absolute top-0 left-0 w-1/3 h-1/3 bg-blue-900/30 blur-[100px] rounded-full z-0 pointer-events-none"></div>
    
    <main class="container mx-auto max-w-6xl z-10 relative">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
            <div class="glass-panel rounded-2xl p-8 md:p-12 flex flex-col justify-center items-center text-center w-full max-w-md mx-auto lg:mx-0 lg:max-w-none h-full">
                
                <a href="/" class="mb-8 relative w-24 h-24 bg-white/10 rounded-full flex items-center justify-center shadow-lg border border-white/10 hover:scale-105 transition-transform duration-300">
                     <img src="newAssets/images/logo/emaquisLogo2.png" alt="E-Maquis Logo" class="w-20 drop-shadow-lg">
                </a>

                <h1 class="text-3xl font-bold mb-8 tracking-tight text-white">Espace Gestionnaire</h1>
                
                <!-- Feedback Alerts (Initally Hidden) -->
                <div class="animSuccessConnect w-full bg-white/90 text-success p-4 rounded-xl mb-6 shadow-lg border-l-4 border-success hidden" id="alert-success">
                    <div class="flex flex-col items-center">
                        <span class="font-bold mb-2">Connexion réussie !</span>
                        <lord-icon
                            src="https://cdn.lordicon.com/iloumlrk.json"
                            trigger="in"
                            delay="100"
                            stroke="bold"
                            state="in-reveal"
                            colors="primary:#06d6a0,secondary:#06d6a0"
                            style="width:50px;height:50px">
                        </lord-icon>
                    </div>
                </div>

                <div class="animFailConnect w-full bg-white/90 text-error p-4 rounded-xl mb-6 shadow-lg border-l-4 border-error hidden" id="alert-danger">
                    <div class="flex flex-col items-center">
                        <span class="font-bold mb-2">Email ou mot de passe incorrect</span>
                         <lord-icon
                            src="https://cdn.lordicon.com/mcxhyndb.json"
                            trigger="loop"
                            delay="2000"
                            state="in-reveal"
                            colors="primary:#ef476f,secondary:#ef476f"
                            style="width:50px;height:50px">
                        </lord-icon>
                    </div>
                </div>

                <form action="#" class="w-full space-y-5" method="POST">
                    <div class="relative group">
                        <input class="w-full pl-4 pr-10 py-3.5 bg-gray-100 dark:bg-gray-800 border-none rounded-xl text-gray-900 dark:text-gray-100 placeholder-gray-500 focus:ring-2 focus:ring-primary transition-all shadow-inner" 
                               id="email" 
                               name="emailOrPhoneNumber" 
                               placeholder="Email ou N° de Téléphone" 
                               type="text" 
                               required 
                               autocomplete="username"/>
                        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-primary transition-colors">
                            <span class="material-icons-round">person</span>
                        </span>
                    </div>
                    
                    <div class="relative group">
                        <input class="w-full pl-4 pr-10 py-3.5 bg-gray-100 dark:bg-gray-800 border-none rounded-xl text-gray-900 dark:text-gray-100 placeholder-gray-500 focus:ring-2 focus:ring-primary transition-all shadow-inner" 
                               id="password" 
                               name="password" 
                               placeholder="Mot de passe" 
                               type="password"
                               required
                               autocomplete="current-password"/>
                        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-primary transition-colors">
                            <span class="material-icons-round">lock</span>
                        </span>
                    </div>
                    
                    <div class="text-right">
                        <a class="text-sm text-gray-300 hover:text-white transition-colors underline-offset-4 hover:underline" href="#">
                            Mot de passe oublié ?
                        </a>
                    </div>
                    
                    <button class="w-full bg-primary hover:bg-primary-hover text-white font-semibold py-3.5 rounded-xl shadow-lg hover:shadow-primary/50 transition-all duration-300 transform hover:-translate-y-0.5 flex items-center justify-center gap-2" type="submit">
                        Se connecter
                        <span class="material-icons-round text-lg">arrow_forward</span>
                    </button>
                </form>
                
                <div class="mt-8 text-sm text-gray-400">
                    Vous n'avez pas de compte ? 
                    <a class="text-white font-semibold hover:underline decoration-primary decoration-2 underline-offset-4" href="/inscription">Créer un compte</a>
                </div>
            </div>

            <!-- Right: DepozUp Promo -->
            <div class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-gray-900 to-gray-800 shadow-2xl border border-gray-700/50 flex flex-col h-full group">
                <div class="absolute inset-0 z-0">
                    <img alt="Woman smiling in warehouse with boxes" class="w-full h-full object-cover opacity-40 group-hover:scale-105 transition-transform duration-700" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAtxcQz6fGnmU1sP_gQQ1kSNFSA5fdNYHH9IpKbmFFubNnkmWpEHhHLc2s4h_SbYnzuKR2ADoJjZ3UMujTtmEn_u8XNHBT637sRMK94pMteKLe3coL3eDo8oiDC5dCbNI0-7UkpO-CcQzE1VVGNSq_obwql0gxveBCV84PbmaahZqBvpBi060jU-YzvokiUxS2vZbNcySVKvbnW74Me8QztI-l8i_kyrRbBdbb0306P5qgZ_fseHewsHOtwFOxzUI75rOeSBk5inCs"/>
                    <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/80 to-transparent"></div>
                </div>
                <div class="relative z-10 p-8 md:p-12 flex flex-col h-full justify-between items-start">
                    <div class="bg-orange-100 dark:bg-orange-900/30 text-depozup-orange dark:text-orange-300 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-6 border border-orange-200 dark:border-orange-700/50">
                        Nouveau Service
                    </div>
                    <div class="mt-auto">
                        <div class="mb-6">
                        <img src="newAssets/images/logo/depozup.png" alt="DepozUp Logo" class="h-16 w-auto drop-shadow-md hover:scale-105 transition-transform duration-300">
                    </div>
                        <h3 class="text-3xl md:text-4xl font-extrabold text-white mb-4 leading-tight">
                            Gérez vos <span class="text-depozup-orange">Dépôts de boissons</span> <br/>en toute simplicité.
                        </h3>
                        <p class="text-gray-300 text-lg mb-8 max-w-md leading-relaxed">
                            Une solution complète pour les professionnels du secteur des boissons. Optimisez votre inventaire, automatisez vos commandes et boostez votre rentabilité.
                        </p>
                        <div class="flex flex-col sm:flex-row gap-4">
                            <a class="bg-white text-gray-900 hover:bg-gray-100 font-bold py-3 px-6 rounded-lg shadow-lg transition-colors flex items-center justify-center gap-2" href="https://depozup.com/" target="_blank">
                                Découvrir DepozUp
                            </a>
                            <a class="bg-transparent border border-gray-500 hover:border-white text-gray-300 hover:text-white font-semibold py-3 px-6 rounded-lg transition-colors flex items-center justify-center" href="https://depozup.com/how-it-works" target="_blank">
                                En savoir plus
                            </a>
                        </div>
                    </div>
                </div>
                <div class="absolute top-10 right-10 pointer-events-none flex items-center justify-center w-24 h-24">
                    <svg class="absolute inset-0 opacity-20" fill="none" viewBox="0 0 100 100" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="50" cy="50" r="40" stroke="white" stroke-dasharray="10 10" stroke-width="2"></circle>
                    </svg>
                    <img src="newAssets/images/logo/depozup.png" alt="" class="w-16 h-16 object-contain filter drop-shadow-lg">
                </div>
            </div>
        </div>
    </main>

    <footer class="absolute bottom-4 w-full text-center z-10 pointer-events-none">
        <div class="pointer-events-auto inline-flex gap-6 text-xs text-gray-400">
            <a class="hover:text-white transition-colors" href="#">Conditions d'utilisation</a>
            <a class="hover:text-white transition-colors" href="#">Politique de confidentialité</a>
            <a class="hover:text-white transition-colors" href="#">Aide</a>
        </div>
    </footer>

    <!-- JAVASCRIPTS -->
    <script src="plugins/jquery/jquery.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>

    <script>
      const socket = io(window.location.origin + window.location.pathname);

      $("form").on("submit", (e) => {
        e.preventDefault();
        const submitButton = $('button[type="submit"]');
        submitButton.prop("disabled", true);
        const originalText = submitButton.html();
        submitButton.html('<span class="material-icons-round animate-spin">refresh</span> Connexion...');

        const data = {
          emailOrPhoneNumber: $('input[name="emailOrPhoneNumber"]').val(),
          password: $('input[name="password"]').val(),
        };

        socket.emit("login", data);

        socket.on("loginsuccess", (data) => {
          if (data && data.token) {
            localStorage.setItem("token", data.token);
          }
          setTimeout(() => {
            // Using Tailwind classes for display toggling if needed, but jquery show/slideDown works fine with 'hidden' class removal
            $("#alert-success").removeClass("hidden").hide().slideDown();
            $('form').slideUp();
          }, 500);

          setTimeout(() => {
            location.href = "/dashboard";
          }, 2500);
        });

        socket.on("bad", () => {
          setTimeout(() => {
            const errorAlert = $("#alert-danger");
            errorAlert.removeClass("hidden").hide().slideDown();
            errorAlert.addClass("shake");
            
            setTimeout(() => {
                errorAlert.removeClass("shake");
            }, 500);
            
          }, 500);

          setTimeout(() => {
            submitButton.prop("disabled", false);
            submitButton.html(originalText);
          }, 1500);
        });
      });

      // Clear alerts on interaction
      $("input").on("focus", () => {
        $(".animFailConnect").slideUp();
      });
    </script>
</body>
</html>
