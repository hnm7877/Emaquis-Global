<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="E-maquis, Gestionnaire d'établissement" />
    <title>Inscription | E-Maquis</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
    <link href="newAssets/css/bootstrap.css" rel="stylesheet" />
    <link
      rel="shortcut icon"
      href="newAssets/images/logo/emaquisLogo2.png"
      type="image/x-icon"
    />
    <script src="https://cdn.lordicon.com/lordicon.js"></script>

    <style>
      :root {
        --primary-color: #4361ee;
        --secondary-color: #3f37c9;
        --accent-color: #4895ef;
        --success-color: #06d6a0;
        --error-color: #ef476f;
        --text-color: #2b2d42;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: "Poppins", sans-serif;
      }

      body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)),
                    url("newAssets/images/background/bg-login.jpg");
        background-size: cover;
        background-position: center;
        background-attachment: fixed; /* Parallax effect */
        padding: 20px;
      }

      /* Glassmorphism Card */
      .container-custom {
        position: relative;
        width: 100%;
        max-width: 900px; /* Wider for 2 cols */
        padding: 40px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
        overflow: hidden;
      }

      /* Logo */
      .logo-area {
        text-align: center;
        margin-bottom: 30px;
      }

      .logo-area img {
        width: 100px;
        filter: drop-shadow(0 5px 15px rgba(0, 0, 0, 0.2));
        transition: transform 0.3s ease;
      }

      .logo-area img:hover {
        transform: scale(1.05);
      }

      h1 {
        text-align: center;
        color: white;
        font-size: 2rem;
        margin-bottom: 30px;
        font-weight: 700;
        text-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
      }

      /* Form Inputs */
      .input-group-custom {
        position: relative;
        margin-bottom: 25px;
      }

      .input-group-custom input,
      .input-group-custom select {
        width: 100%;
        padding: 15px 45px 15px 20px;
        background: rgba(255, 255, 255, 0.9);
        border: none;
        border-radius: 50px;
        font-size: 0.95rem;
        color: var(--text-color);
        outline: none;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        height: auto;
      }

      .input-group-custom select {
         appearance: none;
         cursor: pointer;
      }

      .input-group-custom input:focus,
      .input-group-custom select:focus {
        background: white;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
        transform: translateY(-2px);
      }

      .input-group-custom i {
        position: absolute;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
        color: #666;
        transition: color 0.3s ease;
        pointer-events: none;
      }

      .input-group-custom input:focus + i,
      .input-group-custom select:focus + i {
        color: var(--primary-color);
      }

      /* Button */
      .btn-login {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 50px;
        background: linear-gradient(90deg, #4361ee, #3f37c9);
        color: white;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(67, 97, 238, 0.4);
        margin-top: 20px;
      }

      .btn-login:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(67, 97, 238, 0.5);
      }
      
      .btn-login:disabled {
        background: #ccc;
        cursor: not-allowed;
      }

      /* Register Link */
      .register-text {
        text-align: center;
        margin-top: 25px;
        color: white;
        font-size: 0.95rem;
      }

      .register-text a {
        color: white;
        font-weight: 700;
        text-decoration: none;
        margin-left: 5px;
        text-decoration: underline;
      }

       /* Alerts */
       .alert {
        border-radius: 15px;
        font-weight: 500;
      }

      /* Modal Customization */
      #eventModal {
        border-radius: 15px;
        border: none !important;
        text-align: center;
      }
      #eventModal h2 {
          color: var(--primary-color);
          margin-bottom: 20px;
      }
      #eventModal p {
          color: #555;
          margin-bottom: 25px;
      }
      
      /* Utilities */
      .row {
        margin-left: -10px;
        margin-right: -10px;
      }
      .col-lg-6, .col-md-6 {
        padding-left: 10px;
        padding-right: 10px;
      }

    </style>
  </head>
  <body>

    <div class="container-custom">
      <div class="logo-area">
        <a href="/">
          <img
            src="newAssets/images/logo/emaquisLogo2.png"
            alt="E-Maquis Logo"
          />
        </a>
      </div>

      <h1>Inscrivez-vous</h1>

      <div
        class="alert alert-success"
        role="alert"
        style="text-align: center; display: none"
        id="alert-success"
      >
        L'opération s'est terminée avec succès !
      </div>
      <div
        class="alert alert-danger"
        role="alert"
        style="text-align: center; display: none"
        id="alert-danger"
      >
        Echec de l'opération, nom de l'établissement ou email déjà utilisé!
      </div>

      <form action="">
        <div class="row">
            <!-- Col 1 -->
            <div class="col-md-6">
                <div class="input-group-custom">
                    <input
                      type="text"
                      placeholder="Nom d'utilisateur"
                      name="username"
                      required
                    />
                    <i class="fas fa-user"></i>
                </div>
            </div>
            <!-- Col 2 -->
            <div class="col-md-6">
                <div class="input-group-custom">
                    <input
                      type="text"
                      placeholder="Nom de l'établissement"
                      name="nom_etablissement"
                      required
                    />
                    <i class="fas fa-store"></i>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="input-group-custom">
                    <input
                      type="email"
                      placeholder="Email"
                      name="email"
                      required
                    />
                    <i class="fas fa-envelope"></i>
                </div>
            </div>
            <div class="col-md-6">
                <div class="input-group-custom">
                    <input
                      type="text"
                      placeholder="Adresse"
                      name="adresse"
                      required
                    />
                    <i class="fas fa-map-marker-alt"></i>
                </div>
            </div>
        </div>

        <!-- Event Selection -->
        <div class="row">
            <div class="col-md-6">
                <div class="input-group-custom">
                    <select name="event" id="eventSelect">
                        <option value="" disabled selected>Créer un compte pour un évenement ?</option>
                        <option value="true">OUI 👑</option>
                        <option value="false">NON</option>
                    </select>
                    <i class="fas fa-calendar-check"></i>
                </div>
            </div>
            <div class="col-md-6">
                <div class="input-group-custom">
                    <input
                      name="period"
                      style="display: none"
                      placeholder="Nombre de jour(s)"
                      type="number"
                    />
                    <i class="fas fa-clock" style="display: none" id="clockIcon"></i>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="input-group-custom">
                    <input
                      type="tel"
                      id="numericInput"
                      oninput="validateNumericInput(this)"
                      placeholder="N° de Téléphone"
                      name="numero"
                      required
                    />
                    <i class="fas fa-phone"></i>
                </div>
            </div>
            <div class="col-md-6">
                 <!-- Password fields stacked in one col visually or separate? Old design had them stacked in col-6. Let's split to keep balance or stack.
                 Current loop -> 2 cols per row. Let's put password in one, confirm in other for better balance if space permits.
                 Actually old code had 2 inputs inside one col-6 div. Let's spread them out for better UI.
                 -->
                  <div class="input-group-custom">
                    <input
                      type="password"
                      placeholder="Mot de passe"
                      name="password"
                      required
                    />
                    <i class="fas fa-lock"></i>
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="col-md-6 offset-md-6">
                 <div class="input-group-custom">
                    <input
                      type="password"
                      placeholder="Confirmer le mot de passe"
                      name="confirm_password"
                      required
                    />
                    <i class="fas fa-lock"></i>
                </div>
            </div>
        </div>

        <button type="submit" class="btn-login" id="btn-validate">S'inscrire</button>

        <div class="register-text">
          Avez-vous déjà un compte ?
          <a href="/connexion">Connectez-vous ici</a>
        </div>
      </form>
    </div>

    <!-- JAVASCRIPTS -->
    <script src="plugins/jquery/jquery.min.js"></script>
    <script src="plugins/bootstrap/bootstrap.min.js"></script>
    <script src="/socket.io/socket.io.js "></script>
    
    <script>
       // Modal Script
       document.addEventListener("DOMContentLoaded", function () {
              // Create the modal
              const modal = document.createElement("div");
              modal.id = "eventModal";
              modal.style.position = "fixed";
              modal.style.top = "50%";
              modal.style.left = "50%";
              modal.style.transform = "translate(-50%, -50%)";
              modal.style.backgroundColor = "white";
              modal.style.padding = "30px";
              modal.style.boxShadow = "0 25px 50px -12px rgba(0, 0, 0, 0.5)";
              modal.style.borderRadius = "20px";
              modal.style.zIndex = "1000";
              modal.style.maxWidth = "400px";
              modal.style.width = "90%";
              modal.innerHTML = `
                <h2 style="font-family: Poppins; color:#4361ee; text-align:center;">Nouveau</h2>
                <p style="font-family: Poppins; text-align:center; color:#555; line-height:1.6;">E-maquis vous propose une option pour gérer vos évènements. <br>L'application reste gratuite mais cette option est <b>payante</b>.<br><br> Sélectionnez "OUI 👑" pour gérer un évènement ou "NON" pour un usage gratuit standard.</p>
                <div style="text-align:center;">
                    <button id="closeModal" style="background:#4361ee; color:white; border:none; padding:10px 25px; border-radius:30px; cursor:pointer; font-weight:600;">J'ai compris</button>
                </div>
              `;
              document.body.appendChild(modal);

              // Close modal function
              document
                .getElementById("closeModal")
                .addEventListener("click", function () {
                  modal.style.display = "none";
                  clearInterval(blinkInterval);
                  // Reset border to standard style instead of old one
                  document.querySelector("select[name='event']").style.boxShadow = "0 5px 15px rgba(0, 0, 0, 0.05)";
                  document.querySelector("select[name='event']").style.border = "none";
                });

              // Blink logic
              const eventSelect = document.querySelector("select[name='event']");
              let blink = true;
              const blinkInterval = setInterval(function () {
                if(blink) {
                     eventSelect.style.boxShadow = "0 0 10px #ef476f";
                } else {
                     eventSelect.style.boxShadow = "none";
                }
                blink = !blink;
              }, 600);
            });


      const socket = io(window.location.origin + window.location.pathname);
      console.log(window.location.origin + window.location.pathname);

      $("form").on("submit", (e) => {
        e.preventDefault();
        const btn = $("#btn-validate");
        const originalText = btn.html();
        btn.html('<i class="fas fa-circle-notch fa-spin"></i> En cours...');
        btn.attr("disabled", true);

        const password = $('input[name="password"]').val();
        const confirm_password = $('input[name="confirm_password"]').val();

        if (password !== confirm_password) {
          const alertDanger = document.getElementById("alert-danger");
          alertDanger.innerHTML = "Les mots de passe ne correspondent pas!";
          alertDanger.style.display = "block";
          btn.html("S'inscrire");
          btn.attr("disabled", false);
          return;
        }

        const data = {
          username: $('input[name="username"]').val(),
          email: $('input[name="email"]').val(),
          nom_etablissement: $('input[name="nom_etablissement"]').val(),
          adresse: $('input[name="adresse"]').val(),
          password: password,
          numero: $('input[name="numero"]').val(),
          forEvent: $('select[name="event"]').val(),
          period: $('input[name="period"]').val(),
        };

        socket.emit("setUser", data);

        socket.on("saved", () => {
          document.getElementById("alert-success").style.display = "block";
          $("input").val("");
          btn.html("S'inscrire");
          btn.attr("disabled", false);
          setTimeout(() => {
              document.getElementById("alert-success").style.display = "none";
              location.href = "/config_profil";
          }, 1000);
        });

        socket.on("bad", () => {
          btn.html("S'inscrire");
          btn.attr("disabled", false);
          document.getElementById("alert-danger").innerHTML = "Echec de l'opération, nom de l'établissement ou email déjà utilisé!";
          setTimeout(() => {
              document.getElementById("alert-danger").style.display = "block";
          }, 500);
        });
      });

      // Toggle period input
      document.addEventListener("DOMContentLoaded", function () {
        const eventSelect = document.querySelector('select[name="event"]');
        const dureeInput = document.querySelector('input[name="period"]');
        const clockIcon = document.getElementById('clockIcon');

        eventSelect.addEventListener("change", function () {
          if (eventSelect.value === "true") {
            dureeInput.style.display = "block";
            dureeInput.required = true;
            if(clockIcon) clockIcon.style.display = "block";
          } else {
            dureeInput.style.display = "none";
            dureeInput.required = false;
            dureeInput.value = "";
            if(clockIcon) clockIcon.style.display = "none";
          }
        });
      });

      function validateNumericInput(input) {
        input.value = input.value.replace(/\D/g, "");
      }
    </script>
  </body>
</html>
