<!--
  Modal de don — E-Maquis (GeniusPay Integration)
  Flux : Sélection montant → POST /donate (AJAX) → Redirection checkout GeniusPay
-->

<style>
  /* Custom Styles for Donation Modal */
  .donation-modal-content {
      border: none;
      border-radius: 20px;
      overflow: visible;
      box-shadow: 0 15px 35px rgba(0,0,0,0.2);
  }

  .modal-hero-header {
      background: linear-gradient(135deg, #ff9966, #ff5e62);
      padding: 30px 20px;
      text-align: center;
      color: white;
      position: relative;
      border-radius: 20px 20px 0 0;
  }
  
  .modal-hero-header .close {
      position: absolute;
      top: 15px;
      right: 20px;
      color: white;
      opacity: 0.8;
      text-shadow: none;
      transition: opacity 0.3s;
  }
  
  .modal-hero-header .close:hover {
      opacity: 1;
      color: white;
  }

  .modal-hero-icon {
      font-size: 3rem;
      margin-bottom: 10px;
      animation: heartBeat 2s infinite;
  }

  .chip-container {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
      margin-bottom: 20px;
  }

  .amount-chip {
      padding: 8px 16px;
      border: 2px solid #eee;
      border-radius: 50px;
      cursor: pointer;
      font-weight: 600;
      color: #666;
      transition: all 0.3s ease;
      background: white;
  }

  .amount-chip:hover {
      border-color: #ff5e62;
      color: #ff5e62;
      transform: translateY(-2px);
  }

  .amount-chip.active {
      background: linear-gradient(135deg, #ff9966, #ff5e62);
      color: white;
      border-color: transparent;
      box-shadow: 0 4px 10px rgba(255, 94, 98, 0.3);
  }

  .custom-input-group {
      position: relative;
      margin-bottom: 1rem;
  }

  .custom-input-group input {
      height: 50px;
      border-radius: 12px;
      border: 2px solid #eee;
      padding-left: 20px;
      font-size: 1.1rem;
      font-weight: bold;
  }
  
  .custom-input-group input:focus {
      border-color: #ff5e62;
      box-shadow: none;
  }

  .btn-donate-submit {
      background: linear-gradient(135deg, #ff9966, #ff5e62);
      border: none;
      border-radius: 12px;
      padding: 12px 30px;
      font-size: 1.1rem;
      font-weight: bold;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 15px rgba(255, 94, 98, 0.4);
      transition: all 0.3s;
      width: 100%;
  }

  .btn-donate-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(255, 94, 98, 0.5);
  }

  .btn-donate-submit:disabled {
      opacity: 0.7;
      cursor: not-allowed;
      transform: none;
  }

  .donate-spinner {
      display: inline-block;
      width: 20px;
      height: 20px;
      border: 3px solid rgba(255,255,255,0.3);
      border-radius: 50%;
      border-top-color: white;
      animation: spin 0.8s ease-in-out infinite;
      vertical-align: middle;
      margin-right: 8px;
  }

  .payment-methods-preview {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 15px;
      flex-wrap: wrap;
  }

  .payment-method-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.7rem;
      font-weight: 600;
      background: rgba(255,255,255,0.15);
      color: rgba(255,255,255,0.9);
      backdrop-filter: blur(4px);
  }

  /* Keyframes */
  @keyframes heartBeat {
      0% { transform: scale(1); }
      14% { transform: scale(1.3); }
      28% { transform: scale(1); }
      42% { transform: scale(1.3); }
      70% { transform: scale(1); }
  }

  @keyframes spin {
      to { transform: rotate(360deg); }
  }

  /* Success Animation CSS */
  .success-checkmark {
      width: 80px;
      height: 115px;
      margin: 0 auto;
  }

  .check-icon {
      width: 80px;
      height: 80px;
      position: relative;
      border-radius: 50%;
      box-sizing: content-box;
      border: 4px solid #4CAF50;
  }

  .check-icon::before {
      top: 3px;
      left: -2px;
      width: 30px;
      transform-origin: 100% 50%;
      border-radius: 100px 0 0 100px;
  }

  .check-icon::after {
      top: 0;
      left: 30px;
      width: 60px;
      transform-origin: 0 50%;
      border-radius: 0 100px 100px 0;
      animation: rotate-circle 4.25s ease-in;
  }

  .check-icon::before, .check-icon::after {
      content: '';
      height: 100px;
      position: absolute;
      background: #FFFFFF;
      transform: rotate(-45deg);
  }

  .icon-line {
      height: 5px;
      background-color: #4CAF50;
      display: block;
      border-radius: 2px;
      position: absolute;
      z-index: 10;
  }

  .icon-line.line-tip {
      top: 46px;
      left: 14px;
      width: 25px;
      transform: rotate(45deg);
      animation: icon-line-tip 0.75s;
  }

  .icon-line.line-long {
      top: 38px;
      right: 8px;
      width: 47px;
      transform: rotate(-45deg);
      animation: icon-line-long 0.75s;
  }

  .icon-circle {
      top: -4px;
      left: -4px;
      z-index: 10;
      width: 80px;
      height: 80px;
      border-radius: 50%;
      position: absolute;
      box-sizing: content-box;
      border: 4px solid rgba(76, 175, 80, .5);
  }

  .icon-fix {
      top: 8px;
      width: 5px;
      left: 26px;
      z-index: 1;
      height: 85px;
      position: absolute;
      transform: rotate(-45deg);
      background-color: #FFFFFF;
  }

  @keyframes rotate-circle {
      0% { transform: rotate(-45deg); }
      5% { transform: rotate(-45deg); }
      12% { transform: rotate(-405deg); }
      100% { transform: rotate(-405deg); }
  }

  @keyframes icon-line-tip {
      0% { width: 0; left: 1px; top: 19px; }
      54% { width: 0; left: 1px; top: 19px; }
      70% { width: 50px; left: -8px; top: 37px; }
      84% { width: 17px; left: 21px; top: 48px; }
      100% { width: 25px; left: 14px; top: 46px; }
  }

  @keyframes icon-line-long {
      0% { width: 0; right: 46px; top: 54px; }
      65% { width: 0; right: 46px; top: 54px; }
      84% { width: 55px; right: 0px; top: 35px; }
      100% { width: 47px; right: 8px; top: 38px; }
  }
</style>

<div
class="modal fade"
id="donateModal"
tabindex="-1"
role="dialog"
aria-labelledby="donateModalLabel"
aria-hidden="true"
>
<div class="modal-dialog modal-dialog-centered" role="document">
  <div class="modal-content donation-modal-content animated fadeInUp">
    
    <div class="modal-hero-header">
      <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
      <div class="modal-hero-icon">❤️</div>
      <h4 class="font-weight-bold text-white mb-2">Soutenez notre mission</h4>
      <p class="mb-0 text-white-50 small">Votre impact grandit avec chaque don.</p>
      
      <!-- Méthodes de paiement disponibles -->
      <div class="payment-methods-preview">
        <span class="payment-method-badge">🌊 Wave</span>
        <span class="payment-method-badge">🟠 Orange</span>
        <span class="payment-method-badge">🟡 MTN</span>
        <span class="payment-method-badge">💳 Carte</span>
        <span class="payment-method-badge">🟣 Moov</span>
      </div>
    </div>

    <form id="donationForm">
      <div class="modal-body p-4">
        
        <!-- View 1: Donation Form -->
        <div id="donationFormView">
            <label class="d-block text-muted font-weight-bold mb-3 text-center text-uppercase small">Choisissez un montant</label>
            
            <div class="chip-container">
              <div class="amount-chip" data-value="500">500 F</div>
              <div class="amount-chip" data-value="1000">1 000 F</div>
              <div class="amount-chip active" data-value="2000">2 000 F</div>
              <div class="amount-chip" data-value="5000">5 000 F</div>
              <div class="amount-chip" data-value="10000">10 000 F</div>
            </div>
    
            <div class="custom-input-group mt-4">
              <label for="donateAmount" class="text-muted small">Ou entrez un montant personnalisé (FCFA)</label>
              <input
                type="number"
                class="form-control"
                id="donateAmount"
                name="amount"
                min="200"
                required
                value="2000"
                placeholder="Ex: 1500"
              />
              <small class="text-muted d-block mt-1">Montant minimum : 200 FCFA</small>
            </div>

            <!-- Message d'erreur -->
            <div id="donateErrorMsg" class="alert alert-danger mt-3" style="display: none;" role="alert"></div>
        </div>

        <!-- View 2: Success Animation (shown after redirect back) -->
        <div id="donationSuccessView" style="display: none; text-align: center; padding: 20px 0;">
            <div class="success-checkmark">
              <div class="check-icon">
                <span class="icon-line line-tip"></span>
                <span class="icon-line line-long"></span>
                <div class="icon-circle"></div>
                <div class="icon-fix"></div>
              </div>
            </div>
            <h3 class="mt-4 mb-2 text-success" style="font-weight: 700;">Merci infiniment !</h3>
            <p class="text-muted mb-4">Votre générosité nous aide à grandir. ❤️</p>
            <button type="button" class="btn btn-outline-success rounded-pill px-4 py-2 font-weight-bold" onclick="window.location.reload()">
                Fermer
            </button>
        </div>

      </div>
      
      <div class="modal-footer border-0 pt-0 pb-4 px-4" id="donationFooter">
        <button type="button" id="btn-donate-trigger" class="btn btn-primary btn-donate-submit text-white">
           Faire un don maintenant
        </button>
      </div>
    </form>
  </div>
</div>
</div>

<script>
(function () {
  const lastModalDate = localStorage.getItem("lastModalDate");

  const formatNumber = (number) => {
    return number < 10 ? "0" + number : number;
  };

  function bindDonationUi() {
    // Chips de montant
    document.querySelectorAll(".amount-chip").forEach((chip) => {
      chip.addEventListener("click", function () {
        document.querySelectorAll(".amount-chip").forEach((c) => c.classList.remove("active"));
        this.classList.add("active");
        document.getElementById("donateAmount").value = this.getAttribute("data-value");
        hideError();
      });
    });

    const amountInput = document.getElementById("donateAmount");
    if (amountInput) {
      amountInput.addEventListener("input", function () {
        const val = this.value;
        document.querySelectorAll(".amount-chip").forEach((c) => c.classList.remove("active"));
        const matchingChip = document.querySelector('.amount-chip[data-value="' + val + '"]');
        if (matchingChip) matchingChip.classList.add("active");
        hideError();
      });
    }

    // Bouton de don
    const trigger = document.getElementById("btn-donate-trigger");
    if (!trigger) return;

    trigger.addEventListener("click", async function () {
      const amountRaw = document.getElementById("donateAmount").value;
      const amount = parseInt(amountRaw, 10);

      if (isNaN(amount) || amount < 200) {
        showError("Veuillez entrer un montant valide (minimum 200 FCFA).");
        return;
      }

      // Désactiver le bouton et afficher le spinner
      trigger.disabled = true;
      trigger.innerHTML = '<span class="donate-spinner"></span> Redirection en cours...';
      hideError();

      try {
        const response = await fetch("/donate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ amount: amount }),
        });

        const data = await response.json();

        if (data.success && data.checkout_url) {
          // Rediriger vers la page de checkout GeniusPay
          window.location.href = data.checkout_url;
        } else {
          showError(data.message || "Une erreur est survenue. Veuillez réessayer.");
          resetButton();
        }
      } catch (err) {
        console.error("Donate error:", err);
        showError("Erreur de connexion. Vérifiez votre connexion internet et réessayez.");
        resetButton();
      }
    });
  }

  function showError(msg) {
    var el = document.getElementById("donateErrorMsg");
    if (el) {
      el.textContent = msg;
      el.style.display = "block";
    }
  }

  function hideError() {
    var el = document.getElementById("donateErrorMsg");
    if (el) el.style.display = "none";
  }

  function resetButton() {
    var trigger = document.getElementById("btn-donate-trigger");
    if (trigger) {
      trigger.disabled = false;
      trigger.innerHTML = "Faire un don maintenant";
    }
  }

  function autoShowModal() {
    const href = window.location.href;
    const lastPath = href.split("/").pop();
    try {
      const totalOrderValidate = "<%= typeof locals.totalVentesValidate !== 'undefined' ? locals.totalVentesValidate : '' %>";
      const pagesNotToDisplayModal = [
        "connexion",
        "inscription",
        "donate-success",
        "donate-error",
      ];

      if (
        !lastPath ||
        pagesNotToDisplayModal.includes(lastPath) ||
        isNaN(totalOrderValidate) ||
        Number(totalOrderValidate) < 10
      ) {
        return;
      }
    } catch (e) {
      return;
    }

    const show = () => {
      setTimeout(function () {
        var $ = window.jQuery;
        var el = document.getElementById("donateModal");
        if ($ && el && $.fn.modal) {
          $(el).modal("show");
        } else if (el && window.bootstrap && window.bootstrap.Modal) {
          window.bootstrap.Modal.getOrCreateInstance(el).show();
        }
      }, 1000);
      localStorage.setItem("lastModalDate", new Date().toISOString());
    };

    if (!lastModalDate) {
      show();
    } else {
      const lastModalDateObj = new Date(lastModalDate);
      const currentDate = new Date();
      const dateFormat =
        formatNumber(currentDate.getDate()) +
        "/" +
        formatNumber(currentDate.getMonth() + 1) +
        "/" +
        currentDate.getFullYear();
      const lastModalDateFormat =
        formatNumber(lastModalDateObj.getDate()) +
        "/" +
        formatNumber(lastModalDateObj.getMonth() + 1) +
        "/" +
        lastModalDateObj.getFullYear();

      if (lastModalDateFormat !== dateFormat) {
        show();
      }
    }
  }

  function scheduleAutoShow() {
    window.addEventListener("load", function () {
      autoShowModal();
      setInterval(autoShowModal, 5 * 60 * 1000);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", function () {
      bindDonationUi();
      scheduleAutoShow();
    });
  } else {
    bindDonationUi();
    scheduleAutoShow();
  }
})();
</script>
