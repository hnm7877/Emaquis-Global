<!--Bootstrap modal center with title and input for amount min 100 and button success validate global with form to validate min-->
<!-- Path: views/partial/donateModal.ejs -->

<style>
  /* Custom Styles for Donation Modal */
  .donation-modal-content {
      border: none;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 15px 35px rgba(0,0,0,0.2);
  }

  .modal-hero-header {
      background: linear-gradient(135deg, #ff9966, #ff5e62);
      padding: 30px 20px;
      text-align: center;
      color: white;
      position: relative;
  }
  
  .modal-hero-header .close {
      position: absolute;
      top: 15px;
      right: 20px;
      color: white;
      opacity: 0.8;
      text-shadow: none;
      transition: opacity 0.3s;
  }
  
  .modal-hero-header .close:hover {
      opacity: 1;
      color: white;
  }

  .modal-hero-icon {
      font-size: 3rem;
      margin-bottom: 10px;
      animation: heartBeat 2s infinite;
  }

  .chip-container {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
      margin-bottom: 20px;
  }

  .amount-chip {
      padding: 8px 16px;
      border: 2px solid #eee;
      border-radius: 50px;
      cursor: pointer;
      font-weight: 600;
      color: #666;
      transition: all 0.3s ease;
      background: white;
  }

  .amount-chip:hover {
      border-color: #ff5e62;
      color: #ff5e62;
      transform: translateY(-2px);
  }

  .amount-chip.active {
      background: linear-gradient(135deg, #ff9966, #ff5e62);
      color: white;
      border-color: transparent;
      box-shadow: 0 4px 10px rgba(255, 94, 98, 0.3);
  }

  .custom-input-group {
      position: relative;
      margin-bottom: 1rem;
  }

  .custom-input-group input {
      height: 50px;
      border-radius: 12px;
      border: 2px solid #eee;
      padding-left: 20px;
      font-size: 1.1rem;
      font-weight: bold;
  }
  
  .custom-input-group input:focus {
      border-color: #ff5e62;
      box-shadow: none;
  }

  .btn-donate-submit {
      background: linear-gradient(135deg, #ff9966, #ff5e62);
      border: none;
      border-radius: 12px;
      padding: 12px 30px;
      font-size: 1.1rem;
      font-weight: bold;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 15px rgba(255, 94, 98, 0.4);
      transition: all 0.3s;
      width: 100%;
  }

  .btn-donate-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(255, 94, 98, 0.5);
  }

  /* Keyframes for heartbeat */
  @keyframes heartBeat {
      0% { transform: scale(1); }
      14% { transform: scale(1.3); }
      28% { transform: scale(1); }
      42% { transform: scale(1.3); }
      70% { transform: scale(1); }
  }

  /* FIX: CinetPay Z-Index Override */
  .cp-modal, .cp-content-wrapper {
      z-index: 99999 !important;
  }
</style>

<div
class="modal fade"
id="donateModal"
tabindex="-1"
role="dialog"
aria-labelledby="donateModalLabel"
aria-hidden="true"
>
<div class="modal-dialog modal-dialog-centered" role="document">
  <div class="modal-content donation-modal-content animated fadeInUp">
    
    <div class="modal-hero-header">
      <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
      <div class="modal-hero-icon">❤️</div>
      <h4 class="font-weight-bold text-white mb-2">Soutenez notre mission</h4>
      <p class="mb-0 text-white-50 small">Votre impact grandit avec chaque don.</p>
    </div>

    <form id="donationForm">
      <div class="modal-body p-4">
        
        <!-- View 1: Donation Form -->
        <div id="donationFormView">
            <label class="d-block text-muted font-weight-bold mb-3 text-center text-uppercase small">Choisissez un montant</label>
            
            <div class="chip-container">
              <div class="amount-chip" data-value="100">100 F</div>
              <div class="amount-chip" data-value="500">500 F</div>
              <div class="amount-chip" data-value="1000">1 000 F</div>
              <div class="amount-chip active" data-value="2000">2 000 F</div>
              <div class="amount-chip" data-value="5000">5 000 F</div>
            </div>
    
            <div class="custom-input-group mt-4">
              <label for="amount" class="text-muted small">Ou entrez un montant personnalisé (FCFA)</label>
              <input
                type="number"
                class="form-control"
                id="amount"
                name="amount"
                min="100"
                required
                value="2000"
                placeholder="Ex: 1500"
              />
            </div>
        </div>

        <!-- View 2: Success Animation -->
        <div id="donationSuccessView" style="display: none; text-align: center; padding: 20px 0;">
            <div class="success-checkmark">
              <div class="check-icon">
                <span class="icon-line line-tip"></span>
                <span class="icon-line line-long"></span>
                <div class="icon-circle"></div>
                <div class="icon-fix"></div>
              </div>
            </div>
            <h3 class="mt-4 mb-2 text-success" style="font-weight: 700;">Merci infiniment !</h3>
            <p class="text-muted mb-4">Votre générosité nous aide à grandir. ❤️</p>
            <button type="button" class="btn btn-outline-success rounded-pill px-4 py-2 font-weight-bold" onclick="window.location.reload()">
                Fermer
            </button>
        </div>

      </div>
      
      <div class="modal-footer border-0 pt-0 pb-4 px-4" id="donationFooter">
        <button type="button" id="btn-donate-trigger" class="btn btn-primary btn-donate-submit text-white">
           Faire un don maintenant
        </button>
      </div>
    </form>
  </div>
</div>
</div>

<style>
/* Success Animation CSS */
.success-checkmark {
    width: 80px;
    height: 115px;
    margin: 0 auto;
}

.check-icon {
    width: 80px;
    height: 80px;
    position: relative;
    border-radius: 50%;
    box-sizing: content-box;
    border: 4px solid #4CAF50;
}

.check-icon::before {
    top: 3px;
    left: -2px;
    width: 30px;
    transform-origin: 100% 50%;
    border-radius: 100px 0 0 100px;
}

.check-icon::after {
    top: 0;
    left: 30px;
    width: 60px;
    transform-origin: 0 50%;
    border-radius: 0 100px 100px 0;
    animation: rotate-circle 4.25s ease-in;
}

.check-icon::before, .check-icon::after {
    content: '';
    height: 100px;
    position: absolute;
    background: #FFFFFF;
    transform: rotate(-45deg);
}

.icon-line {
    height: 5px;
    background-color: #4CAF50;
    display: block;
    border-radius: 2px;
    position: absolute;
    z-index: 10;
}

.icon-line.line-tip {
    top: 46px;
    left: 14px;
    width: 25px;
    transform: rotate(45deg);
    animation: icon-line-tip 0.75s;
}

.icon-line.line-long {
    top: 38px;
    right: 8px;
    width: 47px;
    transform: rotate(-45deg);
    animation: icon-line-long 0.75s;
}

.icon-circle {
    top: -4px;
    left: -4px;
    z-index: 10;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    position: absolute;
    box-sizing: content-box;
    border: 4px solid rgba(76, 175, 80, .5);
}

.icon-fix {
    top: 8px;
    width: 5px;
    left: 26px;
    z-index: 1;
    height: 85px;
    position: absolute;
    transform: rotate(-45deg);
    background-color: #FFFFFF;
}

@keyframes rotate-circle {
    0% { transform: rotate(-45deg); }
    5% { transform: rotate(-45deg); }
    12% { transform: rotate(-405deg); }
    100% { transform: rotate(-405deg); }
}

@keyframes icon-line-tip {
    0% { width: 0; left: 1px; top: 19px; }
    54% { width: 0; left: 1px; top: 19px; }
    70% { width: 50px; left: -8px; top: 37px; }
    84% { width: 17px; left: 21px; top: 48px; }
    100% { width: 25px; left: 14px; top: 46px; }
}

@keyframes icon-line-long {
    0% { width: 0; right: 46px; top: 54px; }
    65% { width: 0; right: 46px; top: 54px; }
    84% { width: 55px; right: 0px; top: 35px; }
    100% { width: 47px; right: 8px; top: 38px; }
}
</style>

<script src="https://cdn.cinetpay.com/seamless/main.js"></script>
<script>
(function () {
  const lastModalDate = localStorage.getItem("lastModalDate");

  const formatNumber = (number) => {
    return number < 10 ? "0" + number : number;
  };

  /** Montant CinetPay : multiple de 5 (hors USD) — doc initialisation */
  function normalizeDonationAmount(raw) {
    const n = parseInt(String(raw), 10);
    if (Number.isNaN(n) || n < 100) return null;
    const rounded = Math.round(n / 5) * 5;
    return Math.max(100, rounded);
  }

  /** Numéro exploitable par les wallets (ex. Wave CI) : format international */
  function normalizePhoneForCinetPay(raw) {
    if (raw == null || raw === "") return "+2250102030405";
    let s = String(raw).replace(/\s+/g, "").replace(/-/g, "");
    const digits = s.replace(/\D/g, "");
    if (digits.length < 8 || /^0+$/.test(digits)) return "+2250102030405";
    if (s.startsWith("+")) return s.length >= 12 ? s : "+2250102030405";
    if (s.startsWith("225") && s.length >= 11) return "+" + s;
    if (s.startsWith("0") && s.length === 10) return "+225" + s.slice(1);
    if (digits.length >= 8) return "+225" + digits.replace(/^0+/, "");
    return "+2250102030405";
  }

  function bindDonationUi() {
    document.querySelectorAll(".amount-chip").forEach((chip) => {
      chip.addEventListener("click", function () {
        document.querySelectorAll(".amount-chip").forEach((c) => c.classList.remove("active"));
        this.classList.add("active");
        document.getElementById("amount").value = this.getAttribute("data-value");
      });
    });

    const amountInput = document.getElementById("amount");
    if (amountInput) {
      amountInput.addEventListener("input", function () {
        const val = this.value;
        document.querySelectorAll(".amount-chip").forEach((c) => c.classList.remove("active"));
        const matchingChip = document.querySelector('.amount-chip[data-value="' + val + '"]');
        if (matchingChip) matchingChip.classList.add("active");
      });
    }

    const trigger = document.getElementById("btn-donate-trigger");
    if (!trigger) return;

    trigger.addEventListener("click", function () {
      const amountNorm = normalizeDonationAmount(document.getElementById("amount").value);
      if (amountNorm === null) {
        alert("Veuillez entrer un montant valide (minimum 100 FCFA, multiple de 5).");
        return;
      }

      if (typeof window.CinetPay === "undefined") {
        alert("Le module de paiement ne s'est pas chargé. Vérifiez votre connexion et rechargez la page.");
        return;
      }

      const customer_name = <%- JSON.stringify(locals.user && locals.user.nom ? locals.user.nom : "Donateur") %>;
      const customer_surname = <%- JSON.stringify(locals.user && (locals.user.prenoms || locals.user.prenom) ? (locals.user.prenoms || locals.user.prenom) : "Anonyme") %>;
      const customer_email = <%- JSON.stringify(locals.user && locals.user.email ? locals.user.email : "don@emaquis.com") %>;
      const customer_phone_number = normalizePhoneForCinetPay(
        <%- JSON.stringify(locals.user && locals.user.numero ? String(locals.user.numero) : "") %>
      );
      const customer_address = <%- JSON.stringify(locals.user && locals.user.adresse ? locals.user.adresse : "Abidjan") %>;
      const customer_city = <%- JSON.stringify(locals.user && locals.user.city ? locals.user.city : "Abidjan") %>;
      let customer_country = <%- JSON.stringify(locals.user && locals.user.country ? String(locals.user.country).toUpperCase().slice(0, 2) : "CI") %>;
      if (!customer_country || customer_country.length !== 2) customer_country = "CI";

      const origin = window.location.origin;
      const notifyUrl = origin + "/donate/webhook";
      const returnUrl = origin + "/donate-success";

      const apikey = "<%= cinetpayApiKey %>";
      const site_id = "<%= cinetpaySiteId %>";

      CinetPay.setConfig({
        apikey: apikey,
        site_id: site_id,
        notify_url: notifyUrl,
        return_url: returnUrl,
        mode: "PRODUCTION",
      });

      const transaction_id = "DON" + Date.now() + String(Math.floor(Math.random() * 1000000));

      CinetPay.getCheckout({
        transaction_id: transaction_id,
        amount: amountNorm,
        currency: "XOF",
        channels: "ALL",
        description: "Don E-Maquis",
        customer_name: customer_name,
        customer_surname: customer_surname,
        customer_email: customer_email,
        customer_phone_number: customer_phone_number,
        customer_address: customer_address,
        customer_city: customer_city,
        customer_country: customer_country,
        customer_state: customer_country,
        customer_zip_code: "00000",
      });

      CinetPay.waitResponse(function (data) {
        if (data.status == "REFUSED") {
          alert("Le paiement a échoué. Merci d'essayer à nouveau.");
        } else if (data.status == "ACCEPTED") {
          document.getElementById("donationFormView").style.display = "none";
          document.getElementById("donationFooter").style.display = "none";
          document.getElementById("donationSuccessView").style.display = "block";
          if (typeof confetti === "function") {
            confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
          }
        }
      });

      CinetPay.onError(function (data) {
        console.error("CinetPay onError:", data);
        alert("Une erreur est survenue lors de l'initialisation du paiement.");
      });
    });
  }

  function autoShowModal() {
    const href = window.location.href;
    const lastPath = href.split("/").pop();
    try {
      const totalOrderValidate = "<%= typeof locals.totalVentesValidate !== 'undefined' ? locals.totalVentesValidate : '' %>";
      const pagesNotToDisplayModal = [
        "connexion",
        "inscription",
        "donate-success",
        "donate-error",
      ];

      if (
        !lastPath ||
        pagesNotToDisplayModal.includes(lastPath) ||
        isNaN(totalOrderValidate) ||
        Number(totalOrderValidate) < 10
      ) {
        return;
      }
    } catch (e) {
      return;
    }

    const show = () => {
      setTimeout(function () {
        var $ = window.jQuery;
        var el = document.getElementById("donateModal");
        if ($ && el && $.fn.modal) {
          $(el).modal("show");
        } else if (el && window.bootstrap && window.bootstrap.Modal) {
          window.bootstrap.Modal.getOrCreateInstance(el).show();
        }
      }, 1000);
      localStorage.setItem("lastModalDate", new Date().toISOString());
    };

    if (!lastModalDate) {
      show();
    } else {
      const lastModalDateObj = new Date(lastModalDate);
      const currentDate = new Date();
      const dateFormat =
        formatNumber(currentDate.getDate()) +
        "/" +
        formatNumber(currentDate.getMonth() + 1) +
        "/" +
        currentDate.getFullYear();
      const lastModalDateFormat =
        formatNumber(lastModalDateObj.getDate()) +
        "/" +
        formatNumber(lastModalDateObj.getMonth() + 1) +
        "/" +
        lastModalDateObj.getFullYear();

      if (lastModalDateFormat !== dateFormat) {
        show();
      }
    }
  }

  function scheduleAutoShow() {
    window.addEventListener("load", function () {
      autoShowModal();
      setInterval(autoShowModal, 5 * 60 * 1000);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", function () {
      bindDonationUi();
      scheduleAutoShow();
    });
  } else {
    bindDonationUi();
    scheduleAutoShow();
  }
})();
</script>
