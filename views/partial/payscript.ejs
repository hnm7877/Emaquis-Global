<script src="https://cdn.cinetpay.com/seamless/main.js"></script>
<script>
     let _id = document.getElementById("sess").innerText
     const amount=  parseInt(document.getElementById("totalPrix").innerHTML) ;// Utilisez le paramètre 'price' comme valeur pour 'amount'

 function checkout() {
    CinetPay.setConfig({
        apikey: '<%= cinetpayApiKey %>',
        site_id: '<%= cinetpaySiteId %>',
        notify_url: '<%= publicBaseUrl %>/donate/webhook',
        return_url: '<%= publicBaseUrl %>' + window.location.pathname,
        mode: 'PRODUCTION'
    });
    CinetPay.getCheckout({
        transaction_id: Math.floor(Math.random() * 100000000).toString(), // YOUR TRANSACTION ID
        amount: 100, // Utilisez le paramètre 'price' comme valeur pour 'amount'
        // amount:  parseInt(document.getElementById("totalPrix").innerHTML), // Utilisez le paramètre 'price' comme valeur pour 'amount'
        currency: 'XOF',
        channels: 'ALL',
        description: 'Test de paiement',
        Idmaquis : _id,
        //Fournir ces variables pour le paiements par carte bancaire
        // customer_name:"Joe",//Le nom du client
        // customer_surname:"Down",//Le prenom du client
        // customer_email: "down@test.com",//l'email du client
        // customer_phone_number: "088767611",//l'email du client
        // customer_address : "BP 0024",//addresse du client
        // customer_city: "Antananarivo",// La vsille du client
        // customer_country : "CM",// le code ISO du pays
        // customer_state : "CM",// le code ISO l'état
        // customer_zip_code : "06510", // code postal
    });
    CinetPay.waitResponse(function(data) {
        if (data.status == "REFUSED") {
            let data ={
                    amount,
                    _id,
                }
                socket.emit("paiementdataDB",data)
            console.log("ldkhfskhdsklhk")
            if (alert("Votre paiement a échoué")) {
                window.location.reload();
            }
        } else if (data.status == "ACCEPTED") {
            if (alert("Votre paiement a été effectué avec succès")) {
                let paiementdataDB ={
                    amount,
                    _id,
                }
                socket.emit("paiementdataDB",paiementdataDB)
                window.location.reload();
            }
        }
    });
    CinetPay.onError(function(data) {
        console.log(data);
    });
}
</script>